generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id         String     @id @default(cuid())
  name       String
  email      String     @unique
  password   String
  role       Role       @default(agent)
  avatar     String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  accounts   Account[]
  activities Activity[]
  contacts   Contact[]
  deals      Deal[]
  invoices   Invoice[]
  leads      Lead[]
  quotes     Quote[]
  tasks      Task[]

  @@map("users")
}

model Account {
  id         String     @id @default(cuid())
  name       String
  industry   String?
  website    String?
  phone      String?
  address    String?
  city       String?
  country    String?
  notes      String?    @db.Text
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  userId     String?
  user       User?      @relation(fields: [userId], references: [id])
  activities Activity[]
  contacts   Contact[]
  deals      Deal[]
  documents  Document[]
  invoices   Invoice[]

  @@index([userId], map: "accounts_userId_fkey")
  @@map("accounts")
}

model Contact {
  id         String     @id @default(cuid())
  firstName  String
  lastName   String
  email      String?
  phone      String?
  position   String?
  notes      String?    @db.Text
  tags       String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  accountId  String?
  userId     String?
  activities Activity[]
  account    Account?   @relation(fields: [accountId], references: [id])
  user       User?      @relation(fields: [userId], references: [id])
  leads      Lead[]

  @@index([accountId], map: "contacts_accountId_fkey")
  @@index([userId], map: "contacts_userId_fkey")
  @@map("contacts")
}

model Lead {
  id          String     @id @default(cuid())
  title       String
  firstName   String
  lastName    String
  email       String?
  phone       String?
  company     String?
  source      String?
  status      LeadStatus @default(new)
  score       Int        @default(0)
  value       Float      @default(0)
  notes       String?    @db.Text
  convertedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  userId      String?
  contactId   String?
  activities  Activity[]
  contact     Contact?   @relation(fields: [contactId], references: [id])
  user        User?      @relation(fields: [userId], references: [id])

  @@index([contactId], map: "leads_contactId_fkey")
  @@index([userId], map: "leads_userId_fkey")
  @@map("leads")
}

model Deal {
  id          String         @id @default(cuid())
  title       String
  amount      Float          @default(0)
  probability Int            @default(20)
  closeDate   DateTime?
  notes       String?        @db.Text
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  userId      String?
  accountId   String?
  stageId     String?
  activities  Activity[]
  account     Account?       @relation(fields: [accountId], references: [id])
  stage       PipelineStage? @relation(fields: [stageId], references: [id])
  user        User?          @relation(fields: [userId], references: [id])
  invoices    Invoice[]
  quotes      Quote[]

  @@index([accountId], map: "deals_accountId_fkey")
  @@index([stageId], map: "deals_stageId_fkey")
  @@index([userId], map: "deals_userId_fkey")
  @@map("deals")
}

model Activity {
  id          String       @id @default(cuid())
  type        ActivityType
  title       String
  description String?      @db.Text
  scheduledAt DateTime?
  doneAt      DateTime?
  isDone      Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  userId      String?
  leadId      String?
  contactId   String?
  accountId   String?
  dealId      String?
  account     Account?     @relation(fields: [accountId], references: [id])
  contact     Contact?     @relation(fields: [contactId], references: [id])
  deal        Deal?        @relation(fields: [dealId], references: [id])
  lead        Lead?        @relation(fields: [leadId], references: [id])
  user        User?        @relation(fields: [userId], references: [id])

  @@index([accountId], map: "activities_accountId_fkey")
  @@index([contactId], map: "activities_contactId_fkey")
  @@index([dealId], map: "activities_dealId_fkey")
  @@index([leadId], map: "activities_leadId_fkey")
  @@index([userId], map: "activities_userId_fkey")
  @@map("activities")
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  dueDate     DateTime?
  isDone      Boolean   @default(false)
  priority    String    @default("medium")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])

  @@index([userId], map: "tasks_userId_fkey")
  @@map("tasks")
}

model Quote {
  id          String      @id @default(cuid())
  number      String      @unique
  title       String
  status      String      @default("draft")
  validUntil  DateTime?
  notes       String?     @db.Text
  totalAmount Float       @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  dealId      String?
  userId      String?
  invoices    Invoice[]
  lines       QuoteLine[]
  deal        Deal?       @relation(fields: [dealId], references: [id])
  user        User?       @relation(fields: [userId], references: [id])

  @@index([dealId], map: "quotes_dealId_fkey")
  @@index([userId], map: "quotes_userId_fkey")
  @@map("quotes")
}

model QuoteLine {
  id          String @id @default(cuid())
  description String
  quantity    Float  @default(1)
  unitPrice   Float  @default(0)
  discount    Float  @default(0)
  total       Float  @default(0)
  quoteId     String
  quote       Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId], map: "quote_lines_quoteId_fkey")
  @@map("quote_lines")
}

model Invoice {
  id          String        @id @default(cuid())
  number      String        @unique
  title       String
  status      String        @default("draft")
  dueDate     DateTime?
  paidAt      DateTime?
  notes       String?       @db.Text
  totalAmount Float         @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  accountId   String?
  quoteId     String?
  userId      String?
  dealId      String?
  lines       InvoiceLine[]
  account     Account?      @relation(fields: [accountId], references: [id])
  deal        Deal?         @relation(fields: [dealId], references: [id])
  quote       Quote?        @relation(fields: [quoteId], references: [id])
  user        User?         @relation(fields: [userId], references: [id])

  @@index([accountId], map: "invoices_accountId_fkey")
  @@index([dealId], map: "invoices_dealId_fkey")
  @@index([quoteId], map: "invoices_quoteId_fkey")
  @@index([userId], map: "invoices_userId_fkey")
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(cuid())
  description String
  quantity    Float   @default(1)
  unitPrice   Float   @default(0)
  discount    Float   @default(0)
  total       Float   @default(0)
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId], map: "invoice_lines_invoiceId_fkey")
  @@map("invoice_lines")
}

model Campaign {
  id          String         @id @default(cuid())
  name        String
  subject     String
  body        String         @db.LongText
  status      CampaignStatus @default(draft)
  sentAt      DateTime?
  totalSent   Int            @default(0)
  totalFailed Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("campaigns")
}

model Document {
  id        String   @id @default(cuid())
  name      String
  path      String
  mimeType  String?
  size      Int?
  createdAt DateTime @default(now())
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])

  @@index([accountId], map: "documents_accountId_fkey")
  @@map("documents")
}

model Settings {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text

  @@map("settings")
}

model PipelineStage {
  id        String   @id @default(cuid())
  name      String   @unique
  label     String
  color     String   @default("oklch(0.60 0.22 255)")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deals     Deal[]

  @@map("pipeline_stages")
}

enum Role {
  admin
  agent
}

enum LeadStatus {
  new
  contacted
  qualified
  unqualified
  converted
}

enum ActivityType {
  call
  email
  meeting
  note
}

enum CampaignStatus {
  draft
  running
  completed
  cancelled
}
